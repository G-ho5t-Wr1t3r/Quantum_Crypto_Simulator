# Runtime limits. Copy to .env and adjust; the defaults below are what the code
# uses when no file and no environment variable is present.
#
# There are no secrets here: everything is an operational limit, and the file is
# checked in as an example precisely so the defaults are visible without reading
# the source.

# How many simulations may run at the same time.
#
# The simulator is meant to drive one dashboard, not a batch farm: a single run
# at a time is the normal case, and this ceiling exists to stop a client from
# queueing dozens by accident. Requests beyond it are refused with 429 rather
# than silently queued, so the caller knows the run did not start.
QKD_MAX_CONCURRENT_RUNS=5

# How many finished runs stay in memory, most recent first.
#
# Not unbounded: a run keeps its per-participant views, which are proportional
# to the qubit count, so an untended process would grow without limit. Not one
# either: comparing two runs side by side — the noise-versus-attack figure —
# needs both of them still there.
QKD_RUN_HISTORY=20

# Above this many qubits, a synchronous run is refused and must be started
# asynchronously. Guards the "fast run" endpoint from being handed a
# configuration that would hold the connection open for minutes.
QKD_MAX_SYNC_QUBITS=200
